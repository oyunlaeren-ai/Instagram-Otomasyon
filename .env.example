INSTAGRAM_PROVIDER=official

# Instagram Business Login: Instagram App ID / Instagram App Secret
META_APP_ID=
META_APP_SECRET=

# Meta paneline kaydettiğin tam HTTPS callback (tercih edilen)
# Örnek (kendi domainin): https://your-domain.com/auth/instagram/callback
# Örnek (cloudflared): https://<hostname>.trycloudflare.com/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=

# INSTAGRAM_REDIRECT_URI boşsa: {INSTAGRAM_TUNNEL_ORIGIN}/auth/instagram/callback
INSTAGRAM_TUNNEL_ORIGIN=

# Tunnel'ın yönlendirdiği yerel HTTP dinleyici (Meta'ya yazılmaz)
OAUTH_CALLBACK_PORT=8734
